#!/bin/bash
set -e

# app.js never creates its data directories -- only the create-folders migration
# does, and nothing runs migrations at process start. getAccountDb() needs
# dataDir to exist before the first migration run.
mkdir -p "$SNAP_COMMON/data"
mkdir -p "$SNAP_COMMON/data/server-files"
mkdir -p "$SNAP_COMMON/data/user-files"
